# Fails when the shared library exports anything but vv_* (e.g. leaked
# ggml_*/whisper_*/llama_* symbols from the static deps).
# Usage: cmake -DLIB=<path> -P check_exports.cmake
if(APPLE)
  set(NM_ARGS -gU)
else()
  set(NM_ARGS -D --defined-only)
endif()
execute_process(COMMAND nm ${NM_ARGS} ${LIB}
  OUTPUT_VARIABLE out RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "nm failed on ${LIB}")
endif()
string(REPLACE "\n" ";" lines "${out}")
set(bad "")
set(count 0)
foreach(l ${lines})
  if(l MATCHES " [TtDdBbRrSsWwVv] _?([A-Za-z0-9_.]+)$")
    set(sym "${CMAKE_MATCH_1}")
    if(sym MATCHES "^vv_")
      math(EXPR count "${count}+1")
    elseif(NOT sym MATCHES "^(_edata|_end|__bss_start|_init|_fini|__cxa_.*|_Z.*)$")
      list(APPEND bad "${sym}")
    endif()
  endif()
endforeach()
if(count LESS 1)
  message(FATAL_ERROR "no vv_* symbols exported by ${LIB}")
endif()
if(bad)
  message(FATAL_ERROR "non-vv_ exported symbols: ${bad}")
endif()
message(STATUS "exports OK: ${count} vv_* symbols")
