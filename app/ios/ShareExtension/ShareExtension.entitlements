<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- AUD-06 / AUD-14: the share extension and Runner share this App Group
     (register group.<app id> per flavor in the developer portal).
     APP_BUNDLE_IDENTIFIER (= Runner's PRODUCT_BUNDLE_IDENTIFIER per flavor)
     is a build setting on both targets. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(APP_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
